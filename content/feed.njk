---
layout: false
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>kd7swh.com</title>
  <subtitle>Amateur radio, Linux, microcontrollers — and the Linux User Net weekly links</subtitle>
  <link href="{{ siteUrl }}/feed.xml" rel="self"/>
  <link href="{{ siteUrl }}/"/>
  <id>{{ siteUrl }}/</id>
  <updated>{% if collections.siteFeed.length %}{{ collections.siteFeed | getNewestCollectionItemDate | dateToRfc3339 }}{% else %}{{ siteEpoch }}{% endif %}</updated>
  <author><name>KD7SWH</name></author>
{%- for item in collections.siteFeed %}
  <entry>
  {%- if item.data.tags and "notes" in item.data.tags %}
    <title>{{ item.data.title }}</title>
    <link href="{{ siteUrl }}{{ item.url }}"/>
    <id>{{ siteUrl }}{{ item.url }}</id>
  {%- else %}
    <title>Linux User Net — week of {{ item.date | dateHeading }}</title>
    <link href="{{ siteUrl }}/lun/{{ item.date | isoDate }}/"/>
    <id>{{ siteUrl }}/lun/{{ item.date | isoDate }}/</id>
  {%- endif %}
    <updated>{{ item.date | dateToRfc3339 }}</updated>
    <content type="html">{{ item.templateContent }}</content>
  </entry>
{%- endfor %}
</feed>
