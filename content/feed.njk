---
layout: false
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>kd7swh.com</title>
  <subtitle>Amateur radio, Linux, microcontrollers — and the Linux User Net weekly links</subtitle>
  <link href="{{ siteUrl }}/feed.xml" rel="self"/>
  <link href="{{ siteUrl }}/"/>
  <id>{{ siteUrl }}/</id>
  <updated>{% if collections.lun.length %}{{ collections.lun | getNewestCollectionItemDate | dateToRfc3339 }}{% else %}{{ siteEpoch }}{% endif %}</updated>
  <author><name>KD7SWH</name></author>
{%- for week in collections.lun %}
  <entry>
    <title>Linux User Net — week of {{ week.date | dateHeading }}</title>
    <link href="{{ siteUrl }}/lun/{{ week.date | isoDate }}/"/>
    <id>{{ siteUrl }}/lun/{{ week.date | isoDate }}/</id>
    <updated>{{ week.date | dateToRfc3339 }}</updated>
    <content type="html">{{ week.templateContent }}</content>
  </entry>
{%- endfor %}
</feed>
