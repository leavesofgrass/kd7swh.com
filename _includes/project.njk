{# Project page layout. The license and language lines are part of the
   template so they cannot be forgotten: the site footer says CC BY-NC-SA,
   which must never be mistaken for a code license, and every project
   states what it is built in. A project page without `license:` or
   `language:` in its front matter renders a loud placeholder instead of
   nothing. #}
<h1>{{ title }}</h1>

<p class="project-license"><strong>License:</strong>
{% if license %}{{ license }}{% else %}<em>not yet stated — front matter
needs a <code>license:</code> line before this page should ship</em>{% endif %}
· <strong>Language:</strong>
{% if language %}{{ language }}{% else %}<em>not yet stated — front matter
needs a <code>language:</code> line before this page should ship</em>{% endif %}
{% if repo %} · <a href="{{ repo }}">source</a>{% endif %}</p>

{{ content | safe }}
